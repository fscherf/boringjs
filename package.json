    "src/**",
    "dist/**"
  ],
  "devDependencies": {
    "@types/nunjucks": "^3.2.6",
    "morphdom": "^2.7.8",
    "path-to-regexp": "8.4.2",
    "npm-check-updates": "^22.2.3",
    "nunjucks": "^3.2.4",
    "prettier": "^3.8.4",
